{{define "content"}}
<p class="muted">All schedules and dates use {{.TZName}}.</p>
<div class="table-wrap">
<table>
  <tr><th>Group</th><th>Schedule</th><th>Override</th></tr>
  {{range .Rows}}
  <tr>
    <td>{{if .ConfigErr}}<strong>{{.Name}}</strong>{{else}}<a href="{{$.Base}}/group?name={{.Name}}"><strong>{{.Name}}</strong></a>{{end}}</td>
    {{if .ConfigErr}}<td colspan="2" class="danger">config error: {{.ConfigErr}}</td>{{else}}
    <td>{{groupDesc .Group}}</td>
    <td>{{with ovDesc .Group}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>{{end}}
  </tr>
  {{else}}<tr><td colspan="3" class="muted">No groups yet.</td></tr>{{end}}
</table>
</div>

<fieldset>
  <legend>Create or replace schedule</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="schedule">
    <p><label>Group <input name="group" required></label>
       <label>Start cron <input name="start" placeholder="0 9 * * MON-FRI" required></label>
       <label>Stop cron <input name="stop" placeholder="0 20 * * MON-FRI" required></label></p>
    <button>Save schedule</button>
  </form>
</fieldset>

<fieldset>
  <legend>Create indefinite override</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="override">
    <p><label>Group <input name="group" required></label>
       <label>Override <select name="override"><option>running</option><option>stopped</option><option>disabled</option></select></label></p>
    <button>Save override</button>
  </form>
</fieldset>
{{end}}
