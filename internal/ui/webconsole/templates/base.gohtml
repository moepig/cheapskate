<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cheapskate console</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 64rem; padding: 0 1rem; line-height: 1.5; }
  h1 { font-size: 1.3rem; } h1 a { color: inherit; text-decoration: none; }
  h1 a.nav { float: right; font-size: .85rem; font-weight: normal; opacity: .7; text-decoration: underline; }
  h2 { font-size: 1.05rem; margin-top: 2rem; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  table.kv td, table.kv th { width: 1%; white-space: nowrap; }
  table.kv td:last-child { width: auto; white-space: normal; }
  th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid #8884; font-size: .92rem; }
  th { font-weight: 600; }
  code { font-size: .9rem; }
  form.inline { display: inline; }
  form p { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin: .6rem 0; }
  label { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; }
  label.check { flex-direction: row; align-items: center; gap: .35rem; font-size: .92rem; }
  input, select { font: inherit; padding: .25rem .5rem; border: 1px solid #8886; border-radius: .3rem; background: transparent; color: inherit; }
  button { font: inherit; padding: .3rem .8rem; border: 1px solid #8886; border-radius: .3rem; background: transparent; color: inherit; cursor: pointer; }
  button.primary { background: #2a7c; border-color: #2a7c; color: #fff; }
  button.danger { color: #c22; border-color: #c226; }
  fieldset { border: 1px solid #8886; border-radius: .3rem; margin: 1rem 0; padding: .8rem 1rem; }
  legend { padding: 0 .4rem; font-weight: 600; }
  legend.danger { color: #c22; }
  .msg { background: #2a72; border: 1px solid #2a76; padding: .4rem .8rem; border-radius: .3rem; }
  .err { background: #d332; border: 1px solid #d336; padding: .4rem .8rem; border-radius: .3rem; }
  .danger { color: #c22; }
  .muted { opacity: .65; }
</style>
</head>
<body>
<h1><a href="{{.Base}}/">cheapskate console</a> <a href="{{.Base}}/doctor" class="nav">diagnostics</a></h1>
{{if .Msg}}<p class="msg">{{.Msg}}</p>{{end}}
{{if .Err}}<p class="err">{{.Err}}</p>{{end}}
{{template "content" .}}
</body>
</html>
