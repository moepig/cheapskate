{{define "content"}}
<h2>{{.Detail.Group.Name}}</h2>
<p class="muted">All schedules and dates use {{.TZName}}.</p>
<table>
  <tr><th>Membership tag</th><td><code>cheapskate:group={{.Detail.Group.Name}}</code></td></tr>
  <tr><th>Schedule</th><td>{{groupDesc .Detail.Group}}</td></tr>
  <tr><th>Override</th><td>{{with ovDesc .Detail.Group}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td></tr>
</table>

<h2>Resources</h2>
<div class="table-wrap"><table>
  <tr><th>Type</th><th>Name</th><th>Tag config</th><th>Current state</th></tr>
  {{range .Detail.Resources}}
  <tr><td>{{.Resource.Type}}</td><td><code>{{.Resource.Ref}}</code></td><td>{{cfgDesc .Resource}}</td><td>{{liveDesc .}}</td></tr>
  {{else}}<tr><td colspan="4" class="muted">No resources tagged for this group.</td></tr>{{end}}
</table></div>

<fieldset>
  <legend>Schedule</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="schedule"><input type="hidden" name="group" value="{{.Detail.Group.Name}}">
    <p><label>Start cron <input name="start" value="{{.Detail.Group.StartCron}}" required></label>
       <label>Stop cron <input name="stop" value="{{.Detail.Group.StopCron}}" required></label></p>
    <button>Save schedule</button>
  </form>
</fieldset>

<fieldset>
  <legend>Override</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="override"><input type="hidden" name="group" value="{{.Detail.Group.Name}}">
    <p><label>State <select name="override"><option>running</option><option>stopped</option><option>disabled</option></select></label>
       <label>Until ({{.TZName}}, optional) <input type="datetime-local" name="until" value="{{.DefaultUntil}}"></label></p>
    <button>Save override</button>
  </form>
  {{if .Detail.Group.Override}}
  <form class="inline" method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="clear-override"><input type="hidden" name="group" value="{{.Detail.Group.Name}}">
    <button>Clear override</button>
  </form>
  {{end}}
</fieldset>

<fieldset>
  <legend class="danger">Remove group</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="remove"><input type="hidden" name="group" value="{{.Detail.Group.Name}}">
    <button>Remove</button>
  </form>
</fieldset>
{{end}}
