{{define "content"}}
<h2><strong>{{.Row.Name}}</strong></h2>
<table>
  <tr><th>Mode</th><td>{{.Row.Tag.Mode}}</td></tr>
  <tr><th>Config</th><td>{{tagDesc .Row.Tag}}</td></tr>
  <tr><th>Override</th><td>{{with ovDesc .Row.Override}}{{.}}{{else}}<span class="muted">none</span>{{end}}</td></tr>
  {{if .Row.Err}}<tr><th>Error</th><td class="danger">{{.Row.Err}}</td></tr>{{end}}
</table>

<h2>Members</h2>
<table>
  <tr><th>Resource</th><th>Type</th><th>Restore count</th><th>Last action</th><th>Observed</th><th></th></tr>
  {{range .Row.Members}}
  <tr>
    <td><code>{{.ResourceID}}</code></td>
    <td>{{.Member.Type}}</td>
    <td>{{with .Member.RestoreCount}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
    <td>{{with actDesc .Status}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
    <td>{{with .Status.ObservedState}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
    <td>
      <form class="inline" method="post" action="{{$.Base}}/op">
        <input type="hidden" name="action" value="remove-member">
        <input type="hidden" name="tag" value="{{$.Row.Name}}">
        <input type="hidden" name="id" value="{{.ResourceID}}">
        <button class="danger">Remove</button>
      </form>
    </td>
  </tr>
  {{if .Status.LastError}}
  <tr><td colspan="6" class="danger">last error: {{.Status.LastError}} at {{.Status.LastErrorAt}}</td></tr>
  {{end}}
  {{else}}
  <tr><td colspan="6" class="muted">No members yet.</td></tr>
  {{end}}
</table>

<fieldset>
  <legend>Add member</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="add">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <p><label>Type
       <select name="type">
         <option value="rds-instance">rds-instance</option>
         <option value="rds-cluster">rds-cluster</option>
         <option value="ecs">ecs</option>
       </select>
      </label></p>
    <p><label>Name (rds) <input name="name"></label>
       <label>Cluster (ecs) <input name="cluster"></label>
       <label>Service (ecs) <input name="service"></label>
       <label>Restore count (ecs) <input name="restore_count" size="4"></label></p>
    <button>Add</button>
  </form>
</fieldset>

<fieldset>
  <legend>Override (temporary, expires automatically) — applies to every member</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="override">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <select name="desired"><option>running</option><option>stopped</option></select>
    for
    <select name="for"><option>1h</option><option selected>2h</option><option>4h</option><option>8h</option><option>24h</option></select>
    <button>Apply</button>
  </form>
  {{if .Row.Override}}
  <form class="inline" method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="clear-override">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <button>Clear override</button>
  </form>
  {{end}}
</fieldset>

<fieldset>
  <legend>Pin (fixed state; cron settings are kept) — applies to every member</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="pin">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <select name="desired"><option>stopped</option><option>running</option></select>
    <button>Pin</button>
  </form>
</fieldset>

<fieldset>
  <legend>Schedule (5-field cron) — applies to every member</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="schedule">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <p><label>Start cron <input name="start" value="{{.Row.Tag.StartCron}}" placeholder="0 9 * * 1-5"></label></p>
    <p><label>Stop cron <input name="stop" value="{{.Row.Tag.StopCron}}" placeholder="0 20 * * 1-5"></label></p>
    <p><label>Timezone <input name="timezone" value="{{.Row.Tag.Timezone}}" placeholder="Asia/Tokyo"></label></p>
    <button>Save schedule</button>
  </form>
</fieldset>

<fieldset>
  <legend class="danger">Danger zone</legend>
  <form class="inline" method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="disable">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <button>Disable (keep config, stop managing)</button>
  </form>
  <form class="inline" method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="remove-tag">
    <input type="hidden" name="tag" value="{{.Row.Name}}">
    <button class="danger">Remove tag (delete tag, members, override, statuses)</button>
  </form>
</fieldset>
{{end}}
