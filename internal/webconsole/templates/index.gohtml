{{define "content"}}
<table>
  <tr><th>Tag / member</th><th>Mode</th><th>Config</th><th>Override</th><th>Last action</th><th>Observed (at last action)</th></tr>
  {{range .Rows}}
  {{if .Err}}
  <tr>
    <td><a href="{{$.Base}}/tag?name={{.Name}}"><strong>{{.Name}}</strong></a></td>
    <td colspan="5" class="danger">error: {{.Err}}</td>
  </tr>
  {{else}}
  <tr>
    <td><a href="{{$.Base}}/tag?name={{.Name}}"><strong>{{.Name}}</strong></a></td>
    <td>{{.Tag.Mode}}</td>
    <td>{{tagDesc .Tag}}</td>
    <td>{{with ovDesc .Override}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
    <td colspan="2"></td>
  </tr>
  {{range .Members}}
  <tr>
    <td class="member"><code>{{.ResourceID}}</code></td>
    <td colspan="3"></td>
    <td>{{with actDesc .Status}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
    <td>{{with .Status.ObservedState}}{{.}}{{else}}<span class="muted">-</span>{{end}}</td>
  </tr>
  {{end}}
  {{end}}
  {{else}}
  <tr><td colspan="6" class="muted">No tags yet. Add a resource below to create one.</td></tr>
  {{end}}
</table>

<fieldset>
  <legend>Add resource to a tag (creates the tag on first add)</legend>
  <form method="post" action="{{.Base}}/op">
    <input type="hidden" name="action" value="add">
    <p><label>Tag <input name="tag" placeholder="dev"></label>
       <label>Type
         <select name="type">
           <option value="rds-instance">rds-instance</option>
           <option value="rds-cluster">rds-cluster</option>
           <option value="ecs">ecs</option>
         </select>
       </label></p>
    <p><label>Name (rds) <input name="name"></label>
       <label>Cluster (ecs) <input name="cluster"></label>
       <label>Service (ecs) <input name="service"></label>
       <label>Restore count (ecs) <input name="restore_count" size="4"></label></p>
    <button>Add</button>
  </form>
</fieldset>
{{end}}
