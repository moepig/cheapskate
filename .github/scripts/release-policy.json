{
  "project": "cheapskate",
  "assets": [
    "cheapskate-cli_{version}_linux_amd64.tar.gz",
    "cheapskate-cli_{version}_linux_arm64.tar.gz",
    "cheapskate-cli_{version}_darwin_amd64.tar.gz",
    "cheapskate-cli_{version}_darwin_arm64.tar.gz",
    "cheapskate-cli_{version}_windows_amd64.zip",
    "cheapskate-cli_{version}_windows_arm64.zip",
    "checksums.txt"
  ],
  "binaries": [
    {
      "asset": "cheapskate-cli_{version}_linux_amd64.tar.gz",
      "id": "cheapskate-cli",
      "os": "linux",
      "arch": "amd64"
    },
    {
      "asset": "cheapskate-cli_{version}_linux_arm64.tar.gz",
      "id": "cheapskate-cli",
      "os": "linux",
      "arch": "arm64"
    },
    {
      "asset": "cheapskate-cli_{version}_darwin_amd64.tar.gz",
      "id": "cheapskate-cli",
      "os": "darwin",
      "arch": "amd64"
    },
    {
      "asset": "cheapskate-cli_{version}_darwin_arm64.tar.gz",
      "id": "cheapskate-cli",
      "os": "darwin",
      "arch": "arm64"
    },
    {
      "asset": "cheapskate-cli_{version}_windows_amd64.zip",
      "id": "cheapskate-cli",
      "os": "windows",
      "arch": "amd64"
    },
    {
      "asset": "cheapskate-cli_{version}_windows_arm64.zip",
      "id": "cheapskate-cli",
      "os": "windows",
      "arch": "arm64"
    }
  ],
  "containers": [
    {
      "id": "reconciler",
      "image": "ghcr.io/moepig/cheapskate-reconciler",
      "archive": "reconciler.oci.tar",
      "dockerfile": "build/Dockerfile.reconciler",
      "labels": {
        "org.opencontainers.image.licenses": "MIT",
        "org.opencontainers.image.description": "cheapskate reconcile loop, as a Lambda container image"
      }
    },
    {
      "id": "webconsole",
      "image": "ghcr.io/moepig/cheapskate-webconsole",
      "archive": "webconsole.oci.tar",
      "dockerfile": "build/Dockerfile.webconsole",
      "labels": {
        "org.opencontainers.image.licenses": "MIT",
        "org.opencontainers.image.description": "cheapskate web console, as a Lambda container image"
      }
    }
  ],
  "archive_files": [
    "README.md"
  ]
}
